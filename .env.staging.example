# Staging environment — copy to `.env.staging` on server (never commit).

# ===== IDENTITY (must differ from production) =====
BOT_TOKEN=                    # @BotFather — staging bot only
BOT_USERNAME=mrj7_bot           # must match BotFather token
ADMIN_IDS=

# ===== PUBLIC URLS (DNS A → same server as prod) =====
WEBHOOK_URL=https://staging-host-hooks.rookari.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=
BOT_RUN_MODE=webhook

CABINET_ENABLED=true
CABINET_URL=https://staging-host-cabinet.rookari.com
CABINET_ALLOWED_ORIGINS=https://staging-host-cabinet.rookari.com
CABINET_JWT_SECRET=           # long random; do not reuse prod

# Cabinet build args (used at docker build)
VITE_TELEGRAM_BOT_USERNAME=mrj7_bot
VITE_APP_NAME=Moon VPN Staging

# Miniapp / connect — staging hosts, NOT production
MINIAPP_CUSTOM_URL=https://staging-host-cabinet.rookari.com

# ===== DATA (isolated from prod) =====
POSTGRES_HOST=staging-postgres
POSTGRES_DB=remnawave_bot_staging
POSTGRES_USER=remnawave_user
POSTGRES_PASSWORD=            # strong unique password
REDIS_URL=redis://staging-redis:6379/0

# ===== PANEL (shared prod panel on remnawave-network) =====
REMNAWAVE_API_URL=http://remnawave:3000
REMNAWAVE_API_KEY=
REMNAWAVE_WEBHOOK_ENABLED=false

# ===== PORTS =====
# WEB_API_PORT = port INSIDE bot container (compose maps host 8081:8080)
WEB_API_PORT=8080
CABINET_PORT=3021
WEB_API_ENABLED=true
WEB_API_DEFAULT_TOKEN=

# ===== DEV MCP (Cursor agent — staging only) =====
# REMNAWAVE_DEV_MCP_WRITE=1   # enable inject_staging_webhook + send_test_notification MCP tools
# DEV_MCP_TELEGRAM_ID=        # default telegram_id for write tools (fallback: first ADMIN_IDS)

# ===== PAYMENTS (keep off or test-only on staging) =====
TELEGRAM_STARS_ENABLED=false
C2C_ENABLED=true

# ===== LOCALE =====
DEFAULT_LANGUAGE=fa
LANGUAGE_SELECTION_ENABLED=false
TZ=Asia/Tehran

# Copy remaining keys from .env.example as needed (monitoring, tariffs, etc.)
