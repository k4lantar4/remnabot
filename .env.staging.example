# Staging environment — copy to `.env.staging` on server 2 (never commit).

# ===== IDENTITY (must differ from production) =====
BOT_TOKEN=                    # @BotFather — staging bot only
BOT_USERNAME=                 # e.g. mrj7_bot — must match BotFather token
ADMIN_IDS=

# ===== PUBLIC URLS (DNS A/AAAA → server 2 IP) =====
WEBHOOK_URL=https://staging-hooks.example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=
BOT_RUN_MODE=webhook

CABINET_ENABLED=true
CABINET_URL=https://staging-cabinet.example.com
CABINET_ALLOWED_ORIGINS=https://staging-cabinet.example.com
CABINET_JWT_SECRET=           # long random; do not reuse prod

# Cabinet build args (used at docker build)
VITE_TELEGRAM_BOT_USERNAME=   # same as BOT_USERNAME (cabinet build arg)
VITE_APP_NAME=Moon VPN Staging
CABINET_PORT=3020

# Miniapp / connect — must match staging cabinet, NOT production
MINIAPP_CUSTOM_URL=https://staging-cabinet.example.com

# ===== DATA (isolated from prod) =====
POSTGRES_DB=remnawave_bot_staging
POSTGRES_USER=remnawave_user
POSTGRES_PASSWORD=            # strong unique password
REDIS_URL=redis://redis:6379/0

# ===== PANEL (staging RemnaWave on same Docker network) =====
REMNAWAVE_API_URL=http://remnawave-staging:3000
REMNAWAVE_API_KEY=
REMNAWAVE_WEBHOOK_ENABLED=false

# ===== PORTS (must differ from prod 8080 / 3020 on same host) =====
WEB_API_PORT=8081
CABINET_PORT=3021
WEB_API_ENABLED=true
WEB_API_DEFAULT_TOKEN=

# ===== PAYMENTS (keep off or test-only on staging) =====
TELEGRAM_STARS_ENABLED=false
C2C_ENABLED=true
# Use test amounts; real card numbers only if you accept staging top-ups

# ===== LOCALE =====
DEFAULT_LANGUAGE=fa
LANGUAGE_SELECTION_ENABLED=false
TZ=Asia/Tehran

# Copy remaining keys from .env.example as needed (monitoring, tariffs, etc.)
